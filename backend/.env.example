# Required
ANIMIND_GROQ_API_KEY=your_groq_api_key

# Optional overrides
ANIMIND_PLANNER_MODEL=openai/gpt-oss-120b
ANIMIND_CODER_MODEL=openai/gpt-oss-120b
ANIMIND_FIXER_MODEL=openai/gpt-oss-120b
ANIMIND_FALLBACK_MODEL=qwen/qwen3.8-27b
ANIMIND_TTS_MODEL=canopylabs/orpheus-v1-english
ANIMIND_TTS_VOICE=autumn
ANIMIND_TTS_ENABLED=true
ANIMIND_MAX_SCENE_RETRIES=5
ANIMIND_MAX_PARALLEL_SCENES=2
ANIMIND_CODEGEN_MODE=spec
ANIMIND_SEQUENTIAL_SCENES=true

# Optional AgentRouter vision QA (three JPEG frames at 480px, quality 60)
ANIMIND_ROUTER_API_KEY=
ANIMIND_ROUTER_BASE_URL=https://agentrouter.org/v1
ANIMIND_VISION_MODEL=claude-opus-4-8
ANIMIND_VISION_CRITIQUE=true
ANIMIND_VISION_MAX_FRAMES=3
ANIMIND_VISION_FRAME_WIDTH=480
ANIMIND_VISION_MAX_ATTEMPTS=2
